# ---------------------------------------------------------------------------
# AI Resume Builder and Career Recommendation System - environment template
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
# Set to 1 when running behind HTTPS
SESSION_COOKIE_SECURE=0

# Uploads (megabytes)
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# AI (optional). The application is fully functional without a key:
# every AI feature then transparently falls back to deterministic rules.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Seconds before the AI call is abandoned and the rule-based fallback is used
OPENAI_TIMEOUT=25
